# URLs publicas; nunca inclua credenciais ou tokens nestas variaveis.
# Em producao use HTTPS e inclua /api/v1. Sem URL, o login fica desabilitado.
VITE_PLATFORM_API_BASE_URL=
# Opcional: se vazio, usa VITE_PLATFORM_API_BASE_URL.
VITE_MERCHANT_API_BASE_URL=
# Somente desenvolvimento local:
API_PROXY_TARGET=http://localhost:8080
